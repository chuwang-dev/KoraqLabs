# Gmail SMTP for the contact form.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal password.
GMAIL_USER=koraqlabs@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_TO=koraqlabs@gmail.com

# Public site config
NEXT_PUBLIC_SITE_URL=https://koraqlabs.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2348143832354

# Analytics (optional — leave blank to disable entirely)
NEXT_PUBLIC_GA_ID=

# ── Admin dashboard ──────────────────────────────────────────────────────
# Postgres connection string. Leave blank to run the admin dashboard in
# demo-data mode (viewable, but nothing persists and every number is
# clearly labeled "Demo data").
DATABASE_URL=

# Single administrator login. ADMIN_PASSWORD_HASH is a bcrypt hash, never
# the plaintext password — generate one with:
#   node scripts/hash-password.js "your-new-password"
ADMIN_EMAIL=koraqlabs@gmail.com
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=
